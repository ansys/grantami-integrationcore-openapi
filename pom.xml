<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ansys</groupId>
  <artifactId>grantami-integrationcore-openapi</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Granta MI Integration Core API Client</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven-plugin-version>1.0.0</maven-plugin-version>
    <base-package-version>0.1.0</base-package-version>
    <language>com.ansys.granta.codegen.AnsysPythonClientCodegen</language>
    <swagger-template-version>8.1.0-SNAPSHOT</swagger-template-version>
    <package-name>ansys-grantami-integrationcore-openapi</package-name>
    <package-import-path>ansys.grantami.integrationcore_openapi</package-import-path>
    <package-description>Autogenerated client library for the Granta MI Integration Services API.</package-description>
    <homepage-url>https://github.com/ansys/grantami-integrationcore-openapi</homepage-url>
    <documentation-url>https://grantami.docs.pyansys.com</documentation-url>
    <is-namespace-package>True</is-namespace-package>
    <integration-service-filename>integration_service.yml</integration-service-filename>
    <material-model-service-filename>material_model_service.yml</material-model-service-filename>
    <licenseType>Apache-2.0</licenseType>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.codegen.v3</groupId>
        <artifactId>swagger-codegen-maven-plugin</artifactId>
        <version>3.0.81</version>
        <executions>
          <execution>
            <id>${integration-service-filename}</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/yaml/${integration-service-filename}</inputSpec>
              <language>${language}</language>
              <output>${package-name}</output>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <packageName>${package-import-path}</packageName>
                <projectName>${package-name}</projectName>
                <projectDescription>${package-description}</projectDescription>
                <homepageUrl>${homepage-url}</homepageUrl>
                <documentationUrl>${documentation-url}</documentationUrl>
                <packageVersion>${project.version}</packageVersion>
                <buildNumber>${build-id}</buildNumber>
                <isReleaseBuild>${is-release}</isReleaseBuild>
                <isNamespacePackage>${is-namespace-package}</isNamespacePackage>
                <bindingNamespace>integration</bindingNamespace>
                <licenseType>${licenseType}</licenseType>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>${material-model-service-filename}</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/yaml/${material-model-service-filename}</inputSpec>
              <language>${language}</language>
              <output>${package-name}</output>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <packageName>${package-import-path}</packageName>
                <projectName>${package-name}</projectName>
                <projectDescription>${package-description}</projectDescription>
                <homepageUrl>${homepage-url}</homepageUrl>
                <documentationUrl>${documentation-url}</documentationUrl>
                <packageVersion>${project.version}</packageVersion>
                <buildNumber>${build-id}</buildNumber>
                <isReleaseBuild>${is-release}</isReleaseBuild>
                <isNamespacePackage>${is-namespace-package}</isNamespacePackage>
                <bindingNamespace>material_models</bindingNamespace>
                <licenseType>${licenseType}</licenseType>
              </configOptions>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.ansys</groupId>
            <artifactId>pyansys-swagger-codegen</artifactId>
            <version>${swagger-template-version}</version>
            <scope>compile</scope>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <property>
          <name>!release</name>
        </property>
      </activation>
      <properties>
        <package-version>${base-package-version}.dev${build-id}</package-version>
      </properties>
    </profile>
    <profile>
      <id>release</id>
      <activation>
        <property>
          <name>release</name>
        </property>
      </activation>
      <properties>
        <package-version>${base-package-version}</package-version>
      </properties>
    </profile>
  </profiles>
</project>
